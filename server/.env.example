# ============================================================
# MAS v9 — environment template
# Copy to server/.env for local dev, or paste the values into
# the Render dashboard (Environment tab) for deployment.
# ============================================================

# --- Required ---
# Your Google AI Studio API key (secret — never commit the real one)
GEMINI_API_KEY=

# Preferred model — big free quota (500 calls/day)
GEMINI_MODEL=gemini-3.5-flash-lite

# Bind address: 0.0.0.0 is REQUIRED on Render so its proxy can reach
# the app. Keep 127.0.0.1 for local dev (loopback-only safety).
HOST=0.0.0.0

# --- Model fallback chain — all 10 free-quota models, biggest pool first ---
# Used only when the preferred model hits its RPM/TPM/RPD limit.
MODEL_PRIORITY=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b,gemma-4-26b,gemini-2.5-flash-lite,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash,gemini-3.7-flash,gemini-3.6-flash

# --- Optional (defaults are safe — only set to override) ---
# Hourly AI call cap (default 20 calls/hour)
#AI_RATE_LIMIT_MAX=20
#AI_RATE_LIMIT_WINDOW_MS=3600000

# Custom per-model quotas (JSON; overrides the built-in free-tier table)
#MODEL_BUDGET_JSON={"gemini-3.5-flash-lite":{"rpm":15,"tpm":250000,"rpd":500}}

# Persist sessions to a mounted disk (only with a Render Persistent Disk)
#DATA_FILE=/var/data/sessions.json

# Per-step model overrides (default: all use GEMINI_MODEL)
#GEMINI_ASSESSMENT_MODEL=gemini-3.5-flash-lite
#GEMINI_ROADMAP_MODEL=gemini-3.5-flash-lite
#GEMINI_SYNTHESIS_MODEL=gemini-3.5-flash-lite
